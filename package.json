{
  "name": "evolugk",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:landing": "pnpm --filter evolugk-landing dev",
    "build": "pnpm --filter web build",
    "build:landing": "pnpm --filter evolugk-landing build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "format": "prettier --write .",
    "db": "node scripts/supabase-cli.mjs",
    "test:db": "pnpm --filter web test:db"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.121.0"
  }
}
