# Copiar a .env.local y completar. Este archivo se versiona; .env.local no.

# --- Supabase (público: se puede exponer al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Servidor (NUNCA con prefijo NEXT_PUBLIC_) ---
# SUPABASE_SECRET_KEY=            # acciones del operador, invitaciones, escrituras privilegiadas
# APP_URL=http://localhost:3000   # dirección pública: arma los links de los mails (obligatoria en producción)
# RESEND_API_KEY=                 # envío de mails; sin clave, la interfaz muestra el link para copiar
# EMAIL_FROM=                     # remitente; sin dominio verificado en Resend solo entrega a la cuenta dueña

# --- Se agregan en hitos posteriores (solo servidor, NUNCA con prefijo NEXT_PUBLIC_) ---
# GUARDIAN_SESSION_SECRET=        # hito 2: firma de las sesiones de familia
# CRON_SECRET=                    # hito 6: protege la tarea diaria de las 9:00
# MUX_TOKEN_ID=                   # hito 4: videos
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=
