# Copiar a .env.local y completar. Este archivo se versiona; .env.local no.

# --- Supabase (público: se puede exponer al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Servidor (NUNCA con prefijo NEXT_PUBLIC_) ---
# SUPABASE_SECRET_KEY=            # acciones del operador, invitaciones, escrituras privilegiadas
# APP_URL=http://localhost:3000   # dirección pública: arma los links de los mails (obligatoria en producción)
# RESEND_API_KEY=                 # envío de mails; sin clave, la interfaz muestra el link para copiar
# GUARDIAN_SESSION_SECRET=        # firma las sesiones de familia (mínimo 32 caracteres; ej.: openssl rand -base64 48)
# EMAIL_FROM=                     # remitente; sin dominio verificado en Resend solo entrega a la cuenta dueña

# --- Se agregan en hitos posteriores (solo servidor, NUNCA con prefijo NEXT_PUBLIC_) ---
# CRON_SECRET=                    # protege las tareas programadas (hito 4: mantenimiento de videos; hito 6: tarea diaria)
# MUX_TOKEN_ID=                   # hito 4: videos (Settings > API Access Tokens)
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=             # firma de los avisos de Mux (Settings > Webhooks)
# MUX_SIGNING_KEY_ID=             # firma de la reproduccion (Settings > Signing Keys; no es el token de la API)
# MUX_SIGNING_PRIVATE_KEY=        # clave privada en base64, tal como la entrega Mux
# MUX_TEST_ASSETS=true            # solo cuentas gratuitas: videos de prueba (marca de agua, 10 segundos)
