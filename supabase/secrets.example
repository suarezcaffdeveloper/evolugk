# Copiar a supabase/.secrets.local (ese archivo NO se versiona) y completar.
# Estas credenciales las lee scripts/supabase-cli.mjs; nunca las pegues en el chat.

# Proyecto de DESARROLLO (el identificador que aparece en la URL: https://<ref>.supabase.co)
SUPABASE_PROJECT_REF=udticdfguwfckqrrzdfb

# Token personal: https://supabase.com/dashboard/account/tokens  (empieza con sbp_)
SUPABASE_ACCESS_TOKEN=

# Contraseña de la base de datos del proyecto (Project Settings > Database)
SUPABASE_DB_PASSWORD=
